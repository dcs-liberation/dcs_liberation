    "globals": "^17.14.0",
    "jsdom": "^24.1.3",
    "license-checker": "^25.0.1",
    "ts-node": "^10.9.1",
    "vite": "^6.4.6",
    "vitest": "^5.1.0",
    "wait-on": "^8.0.0"
